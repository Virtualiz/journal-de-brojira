---
/**
 * Lien vers la fiche d'un éditeur ou d'un distributeur (id de src/data/publishers.json).
 *   <PublisherLink id="iello" />              → « Iello »
 *   <PublisherLink id="iello">chez Iello</PublisherLink>
 */
import EntityLink from "./EntityLink.astro";
import { findFiche, publisherHref } from "../../lib/fiches";

interface Props {
  id: string;
  /** Icône de bâtiment devant le nom. */
  icon?: boolean;
}

const { id, icon = false } = Astro.props;
const publisher = await findFiche("publishers", id, "PublisherLink");
const label = publisher?.data.name ?? id;
---

<EntityLink href={publisher && publisherHref(id)} icon={icon ? "building" : undefined}>{Astro.slots.has("default") ? <slot /> : label}</EntityLink>
