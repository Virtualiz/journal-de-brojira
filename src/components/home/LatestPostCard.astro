---
/** Carte « Billet mensuel » : dernier billet publié, sur parchemin encadré. */
import OrnateCard from "../OrnateCard.astro";
import PostCover from "../PostCover.astro";
import Icon from "../Icon.astro";
import { formatDate, postKind, postUrl, readingTime, type Post } from "../../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, author, image } = post.data;
const minutes = readingTime(post);
---

<OrnateCard
  as="article"
  variant="parchment"
  interactive
  class:list={["grid gap-4 p-3 sm:p-4", image && "sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"]}
  aria-labelledby="latest-post-title"
>
  {
    image && (
      <div class="aspect-[16/10] overflow-hidden rounded-[2px] sm:aspect-auto sm:min-h-52">
        <PostCover
          image={image}
          sizes="(min-width: 1024px) 340px, (min-width: 640px) 40vw, calc(100vw - 3.5rem)"
          loading="eager"
        />
      </div>
    )
  }

  <div class="flex flex-col gap-2 px-2 pb-2 sm:py-2">
    <p>
      <span class="badge badge-secondary gap-1.5 font-medium">
        <Icon name="feather" class="size-3.5" />
        {postKind(post)}
      </span>
    </p>
    <h2 id="latest-post-title" class="text-3xl leading-tight lg:text-4xl">
      <a href={postUrl(post)} class="after:absolute after:inset-0 hover:underline">{title}</a>
    </h2>
    <p class="text-[0.95rem] leading-relaxed">{description}</p>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-2 text-sm">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="inline-flex items-center gap-1">
          <Icon name="calendar" class="size-4 text-gold-ink" />
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="clock" class="size-4 text-gold-ink" />
          {minutes} min de lecture
        </span>
        <span>par {author}</span>
      </p>
      <span class="inline-flex items-center gap-1 font-semibold" aria-hidden="true">
        Lire l’article <Icon name="arrow-right" class="size-4 text-gold-ink" />
      </span>
    </div>
  </div>
</OrnateCard>
