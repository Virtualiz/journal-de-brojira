---
/** Contenu « À la une » (dans une bande parchemin) : un billet marqué `featured: true`. */
import PostCover from "../PostCover.astro";
import Icon from "../Icon.astro";
import { formatDate, postUrl, type Post } from "../../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, image } = post.data;
---

<div>
  <h2 id="une-title" class="flex items-center gap-3 text-3xl">
    <Icon name="sparkle" class="size-6 text-gold-ink" />
    À la une
    <span aria-hidden="true" class="h-px flex-1 bg-gold-ink/40"></span>
  </h2>

  <article
    class:list={[
      "relative mt-6 grid gap-5",
      image && "sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]",
    ]}
  >
    {
      image && (
        <div class="aspect-[4/3] overflow-hidden rounded-[2px] shadow-lg ring-1 ring-gold-ink/30">
          <PostCover
            image={image}
            sizes="(min-width: 1024px) 380px, (min-width: 640px) 40vw, calc(100vw - 2rem)"
          />
        </div>
      )
    }
    <div class="flex flex-col gap-3">
      <h3 class="text-2xl leading-tight lg:text-3xl">
        <a href={postUrl(post)} class="after:absolute after:inset-0 hover:underline">{title}</a>
      </h3>
      <p class="leading-relaxed">{description}</p>
      <p class="text-sm">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </p>
      {
        tags.length > 0 && (
          <ul class="relative z-10 flex flex-wrap gap-1.5" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}/`} class="badge badge-outline hover:bg-accent-content hover:text-accent">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <span class="mt-1 inline-flex items-center gap-1 font-semibold" aria-hidden="true">
        Lire l’article <Icon name="arrow-right" class="size-4 text-gold-ink" />
      </span>
    </div>
  </article>
</div>
