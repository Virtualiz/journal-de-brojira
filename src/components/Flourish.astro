---
/** Filet décoratif avec étoile (séparateur discret). Décoratif : aria-hidden. */
interface Props {
  /** left : étoile près du début (en-têtes). center : étoile centrée (citations). */
  align?: "left" | "center";
  class?: string;
}

const { align = "left", class: className } = Astro.props;
---

<div aria-hidden="true" class:list={["flex items-center gap-3 text-primary", className]}>
  <span class:list={["h-px", align === "left" ? "w-16 bg-primary/60" : "flex-1 bg-primary/50"]}></span>
  ✦
  <span class:list={["h-px flex-1", align === "left" ? "bg-primary/25" : "bg-primary/50"]}></span>
</div>
