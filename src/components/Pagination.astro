---
import type { Page } from "astro";

interface Props {
  page: Page;
  /** URL de la première page (ex: "/blog/"). Les suivantes sont `${base}2/`, etc. */
  base: string;
}

const { page, base } = Astro.props;
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const pageUrl = (n: number) => (n === 1 ? base : `${base}${n}/`);
---

{
  page.lastPage > 1 && (
    <nav
      class="join flex justify-center mt-8"
      aria-label="Pagination des articles"
    >
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="join-item btn"
          rel="prev"
          aria-label="Page précédente"
        >
          «
        </a>
      ) : (
        <button class="join-item btn" disabled aria-label="Page précédente">
          «
        </button>
      )}
      {pages.map((n) => (
        <a
          href={pageUrl(n)}
          class:list={[
            "join-item btn",
            { "btn-active btn-primary": n === page.currentPage },
          ]}
          aria-current={n === page.currentPage ? "page" : undefined}
        >
          {n}
        </a>
      ))}
      {page.url.next ? (
        <a
          href={page.url.next}
          class="join-item btn"
          rel="next"
          aria-label="Page suivante"
        >
          »
        </a>
      ) : (
        <button class="join-item btn" disabled aria-label="Page suivante">
          »
        </button>
      )}
    </nav>
  )
}
