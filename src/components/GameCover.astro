---
/**
 * Boîte d'un jeu (image distante optimisée en WebP), ou visuel de remplacement
 * dessiné (cartes en éventail + dé) si la fiche n'a pas d'image.
 * Remplit son conteneur : le parent fixe la taille et le fond (souvent `.parchment`).
 */
import { Image } from "astro:assets";

interface Props {
  image?: string;
  /** Texte alternatif ; "" si le nom du jeu est déjà affiché à côté. */
  alt?: string;
  sizes: string;
  widths?: number[];
  loading?: "eager" | "lazy";
  class?: string;
}

const { image, alt = "", sizes, widths = [240, 480], loading = "lazy", class: className } = Astro.props;
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      inferSize
      format="webp"
      widths={widths}
      sizes={sizes}
      loading={loading}
      class:list={["h-full w-full object-contain drop-shadow-md", className]}
    />
  ) : (
    <svg
      viewBox="0 0 64 48"
      class:list={["h-full max-h-28 w-full text-gold-ink/85", className]}
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
      stroke-linecap="round"
      role={alt ? "img" : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : "true"}
    >
      <!-- Carte du fond, carte de devant (losange), puis dé à 5 points. -->
      <rect x="12" y="7" width="18" height="27" rx="2" transform="rotate(-14 21 20.5)" style="fill: var(--color-accent)" />
      <rect x="21" y="6" width="18" height="27" rx="2" transform="rotate(6 30 19.5)" style="fill: var(--color-accent)" />
      <path d="M30 13.5l3.5 5-3.5 5-3.5-5z" transform="rotate(6 30 19.5)" />
      <rect x="37" y="23" width="17" height="17" rx="3.5" transform="rotate(12 45.5 31.5)" style="fill: var(--color-accent)" />
      <g transform="rotate(12 45.5 31.5)" fill="currentColor" stroke="none">
        <circle cx="41.5" cy="27" r="1.3" /><circle cx="49.5" cy="27" r="1.3" />
        <circle cx="45.5" cy="31.5" r="1.3" />
        <circle cx="41.5" cy="36" r="1.3" /><circle cx="49.5" cy="36" r="1.3" />
      </g>
    </svg>
  )
}
