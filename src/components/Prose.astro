---
// Mise en forme du texte des billets.
// Couleurs : classe `prose-brojira` (global.css), qui remplace les variables --tw-prose-* de daisyUI.
---

<div
  class="prose prose-lg prose-brojira mx-auto max-w-none leading-relaxed
    prose-headings:scroll-mt-20
    prose-h2:mt-14 prose-h2:border-b prose-h2:border-primary/30 prose-h2:pb-2
    prose-h3:mt-10 prose-h3:text-base-content
    prose-a:font-medium prose-a:underline prose-a:underline-offset-2
    prose-li:my-1
    prose-img:rounded-box
    [&_th]:align-top [&_td]:align-top
    [&_table]:block [&_table]:overflow-x-auto"
>
  <slot />
</div>
