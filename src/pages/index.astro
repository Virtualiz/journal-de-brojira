---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingHero from "../components/LandingHero.astro";
import Card from "../components/Card.astro";

import { getCollection } from "astro:content";

const pageTitle = "Journal de Brojira";
const allPosts = await getCollection("blog");
const chronologicPosts = allPosts.sort((a, b) => {
  if (a.data.pubDate < b.data.pubDate) return -1;
  if (a.data.pubDate > b.data.pubDate) return 1;
  return 0;
});
const lastPost = chronologicPosts.findLast(() => true);
---

<BaseLayout pageTitle={pageTitle}>
  <LandingHero />
  <div
    class="p-4
  lg:px-8
  grid
  lg:grid-cols-4
  md:grid-cols-2
  grid-cols-1
  gap-4
  w-auto
  justify-center"
  >
    <Card title="Billets mensuels et hors-série">
      <p>
        Au programme chaque mois : événements, récompenses, sorties attendues et
        petites présentations.

        <div class="aura aura-xs duration-4000 text-primary bg-secondary">
          <div class="card bg-base-100 text-base-content">
            <div class="card-body">
              <span class="text-2xl">{lastPost?.data.title}</span>
              <span class="text-sm text-primary/90"
                >{lastPost?.data.description}</span
              >
              <p class="text-xs italic">
                Par {lastPost?.data.author}, {
                  lastPost?.data.pubDate.toLocaleDateString("fr", {
                    weekday: "long",
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })
                }.
              </p>
            </div>
          </div>
        </div>

      </p>
      <a href={lastPost ? `/posts/${lastPost?.id}/` : "/"} slot="cta">
        <button class="btn btn-primary">Lire cet article</button>
      </a>

      <a href="/blog/" slot="cta">
        <button class="btn btn-secondary">Voir la liste</button>
      </a>
    </Card>

    <Card title="Mes jeux et prototypes <travail en cours>">
      <p>
        Ici vous retrouverez des infos sur mes jeux, prototypes et idées en
        cours
        <ul>
          <li>
            [TODO: affichage dynamique des 3 mis à jour le plus récemment]
          </li>
          <li>Spicy Jo</li>
          <li>Backdoor</li>
        </ul>
      </p>
      <button slot="cta" class="btn btn-primary btn-disabled">Aller voir</button
      >
    </Card>

    <Card title="Fiches <travail en cours>">
      <p>
        Lorsque je cite un jeu, un auteur ou une autrice, ou un éditeur, vous
        trouverez une fiche qui présente rapidement ses informations.
        <br /><br />
      </p>
      <button slot="cta" class="btn btn-primary btn-disabled"
        >Voir les fiches</button
      >
    </Card>

    <Card title="Autres <travail en cours>">
      <p>
        TODO <br /><br />
      </p>
    </Card>
  </div>
</BaseLayout>
