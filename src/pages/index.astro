---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingHero from "../components/LandingHero.astro";
import OrnateCard from "../components/OrnateCard.astro";
import ParchmentBand from "../components/ParchmentBand.astro";
import LatestPostCard from "../components/home/LatestPostCard.astro";
import SectionTiles from "../components/home/SectionTiles.astro";
import FeaturedPost from "../components/home/FeaturedPost.astro";
import { getPublishedPosts, postUrl } from "../lib/posts";

const posts = await getPublishedPosts();
const latest = posts[0];
// Le plus récent des billets marqués `featured: true` (section masquée s'il n'y en a aucun).
const featured = posts.find((p) => p.data.featured);
---

<BaseLayout
  pageTitle="Journal de Brojira"
  description="Billets mensuels, jeux et prototypes en cours, fiches : tout ce que j'aime partager autour du jeu de société."
  image={{ url: "/og-image.png", alt: "Ludotheque pour le journal de Brojira" }}
>
  <LandingHero latestPostHref={latest && postUrl(latest)} />

  <div class="relative z-10 mx-auto max-w-7xl px-4 pt-6 lg:-mt-14 lg:px-8 lg:pt-0">
    <div
      class:list={[
        "grid gap-6",
        latest && "lg:grid-cols-[minmax(0,2.4fr)_minmax(0,1fr)]",
      ]}
    >
      {latest && <LatestPostCard post={latest} />}

      <!-- Citation décorative : desktop seulement. -->
      <OrnateCard as="figure" class="hidden flex-col items-center justify-center gap-3 p-8 text-center lg:flex">
        <span aria-hidden="true" class="font-serif text-6xl leading-none text-primary">“</span>
        <blockquote class="font-serif text-2xl leading-snug italic">
          « Jouer, c’est voyager sans jamais quitter sa table. »
        </blockquote>
        <span aria-hidden="true" class="mt-2 flex w-full items-center gap-3 text-primary">
          <span class="h-px flex-1 bg-primary/50"></span>✦<span class="h-px flex-1 bg-primary/50"></span>
        </span>
      </OrnateCard>
    </div>

    <div class="mt-8 lg:mt-10">
      <SectionTiles />
    </div>
  </div>

  {
    featured ? (
      <ParchmentBand class="mt-14 lg:mt-20" aria-labelledby="une-title">
        <div class="mx-auto max-w-7xl px-4 lg:px-8">
          <div class="max-w-4xl">
            <FeaturedPost post={featured} />
          </div>
        </div>
      </ParchmentBand>
    ) : (
      <div class="h-14 lg:h-20" />
    )
  }
</BaseLayout>
