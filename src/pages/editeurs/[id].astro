---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import GameSections from "../../components/GameSections.astro";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";

export const getStaticPaths = (async () => {
  const publishers = await getCollection("publishers");
  const games = await getCollection("games");
  return publishers.map((publisher) => ({
    params: { id: publisher.id },
    props: {
      publisher,
      published: games.filter((g) => g.data.publisher?.id === publisher.id),
      distributed: games.filter((g) => g.data.distributor?.id === publisher.id),
    },
  }));
}) satisfies GetStaticPaths;

const { publisher, published, distributed } = Astro.props;
const sections = [
  { id: "edites", title: "Jeux édités", games: published },
  { id: "distribues", title: "Jeux distribués", games: distributed },
];
---

<BaseLayout pageTitle={publisher.data.name} description={publisher.data.description ?? `${publisher.data.name} : jeux édités et distribués.`}>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-8 lg:py-12">
    <BackLink href="/editeurs/" label="Tous les éditeurs" />
    <PageHeader title={publisher.data.name} subtitle={publisher.data.description}>
      {
        publisher.data.url && (
          <p class="mt-3">
            <a class="inline-flex items-center gap-1.5 link link-primary" href={publisher.data.url} rel="noopener">
              <Icon name="link" class="size-4" />
              Site web
            </a>
          </p>
        )
      }
    </PageHeader>
    <GameSections sections={sections} />
  </div>
</BaseLayout>
