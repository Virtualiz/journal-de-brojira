---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntries, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import BuyButton from "../../components/BuyButton.astro";
import Flourish from "../../components/Flourish.astro";
import GameCover from "../../components/GameCover.astro";
import GameTile from "../../components/GameTile.astro";
import Icon, { type IconName } from "../../components/Icon.astro";
import OrnateCard from "../../components/OrnateCard.astro";
import Prose from "../../components/Prose.astro";

export const getStaticPaths = (async () => {
  const games = await getCollection("games");
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}) satisfies GetStaticPaths;

const { game } = Astro.props;
const d = game.data;
const { Content } = await render(game);
const hasBody = Boolean(game.body?.trim());

const [authors, artists] = await Promise.all([getEntries(d.authors), getEntries(d.artists)]);
const publisher = d.publisher ? await getEntry(d.publisher) : undefined;
const distributor = d.distributor ? await getEntry(d.distributor) : undefined;
const parent = d.parent ? await getEntry(d.parent) : undefined;
const extensions = (await getCollection("games")).filter((g) => g.data.parent?.id === game.id);

type Link = { href: string; name: string };
type Row = { icon: IconName; label: string; value?: string; links?: Link[] };

const people = (list: typeof authors): Link[] =>
  list.map((p) => ({ href: `/auteurs/${p.id}/`, name: p.data.name }));

// Lignes affichées seulement si renseignées.
const rows: Row[] = [
  { icon: "users", label: "Joueurs", value: d.players },
  { icon: "cake", label: "Âge", value: d.age },
  { icon: "clock", label: "Durée", value: d.duration },
  { icon: "layers", label: "Mécaniques", value: d.mechanics.join(", ") },
  { icon: "lightbulb", label: authors.length > 1 ? "Auteurs" : "Auteur", links: people(authors) },
  { icon: "palette", label: "Illustration", links: people(artists) },
  {
    icon: "building",
    label: "Éditeur",
    links: publisher ? [{ href: `/editeurs/${publisher.id}/`, name: publisher.data.name }] : [],
  },
  {
    icon: "truck",
    label: "Distributeur",
    links: distributor ? [{ href: `/editeurs/${distributor.id}/`, name: distributor.data.name }] : [],
  },
].filter((r) => r.value || (r.links && r.links.length > 0));
---

<BaseLayout
  pageTitle={d.name}
  description={d.description ?? `Fiche du jeu ${d.name}.`}
  image={d.image ? { url: d.image, alt: `Boîte du jeu ${d.name}` } : undefined}
>
  <article class="mx-auto max-w-5xl px-4 py-8 lg:px-8 lg:py-12">
    <BackLink href="/jeux/" label="Tous les jeux" />

    <div class="grid gap-8 md:grid-cols-[18rem_minmax(0,1fr)] lg:gap-12">
      <OrnateCard class="self-start p-2.5">
        <div class="parchment flex aspect-[4/5] items-center justify-center rounded-[2px] p-5">
          <GameCover
            image={d.image}
            alt={d.image ? `Boîte du jeu ${d.name}` : ""}
            widths={[300, 600]}
            sizes="(min-width: 768px) 288px, calc(100vw - 3rem)"
            loading="eager"
          />
        </div>
      </OrnateCard>

      <div class="flex flex-col gap-4">
        <header>
          {
            d.kind !== "jeu" && (
              <p class="mb-2">
                <span class="badge badge-accent capitalize">{d.kind}</span>
              </p>
            )
          }
          <h1 class="text-4xl leading-tight text-primary lg:text-5xl">{d.name}</h1>
          {
            parent && (
              <p class="mt-2">
                {d.kind === "suite" ? "Suite de " : "Extension de "}
                <a class="link link-primary" href={`/jeux/${parent.id}/`}>
                  {parent.data.name}
                </a>
              </p>
            )
          }
          {d.description && <p class="mt-3 text-lg leading-relaxed">{d.description}</p>}
        </header>

        <Flourish />

        <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
          {
            rows.map((r) => (
              <div class="flex gap-3">
                <Icon name={r.icon} class="mt-0.5 size-5 text-primary" />
                <div>
                  <dt class="text-xs font-semibold tracking-wide text-base-content/85 uppercase">{r.label}</dt>
                  <dd>
                    {r.value}
                    {r.links?.map((l, i) => (
                      <>
                        {i > 0 && ", "}
                        <a class="link link-primary" href={l.href}>
                          {l.name}
                        </a>
                      </>
                    ))}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          {
            d.price && (
              <span class="inline-flex items-center gap-2 rounded-field border border-primary/60 px-3 py-1.5 font-semibold text-primary">
                <Icon name="coins" class="size-5" />
                <span class="sr-only">Prix indicatif : </span>
                {d.price}
              </span>
            )
          }
          <BuyButton shops={d.shops} />
        </div>
      </div>
    </div>

    {
      hasBody && (
        <section class="mt-12" aria-labelledby="avis">
          <h2 id="avis" class="mb-4 text-3xl text-primary">Notre avis</h2>
          <Prose>
            <Content />
          </Prose>
        </section>
      )
    }

    {
      extensions.length > 0 && (
        <section class="mt-12" aria-labelledby="extensions">
          <h2 id="extensions" class="mb-4 text-3xl text-primary">Extensions et suites</h2>
          <ul class="grid grid-cols-2 gap-3 sm:gap-6 md:grid-cols-3">
            {extensions.map((g) => (
              <li>
                <GameTile game={g} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
