---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameTile from "../../components/GameTile.astro";
import PageHeader from "../../components/PageHeader.astro";
import LetterNav from "../../components/LetterNav.astro";
import LetterHeading from "../../components/LetterHeading.astro";
import { anchor, groupByLetter } from "../../lib/alphabet";

const games = await getCollection("games");
const { letters, groups } = groupByLetter(games, (g) => g.data.name);
---

<BaseLayout
  pageTitle="Jeux"
  description="Les fiches des jeux cités dans le journal."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-8 lg:py-12">
    <PageHeader title="Les Jeux" subtitle="Les fiches des jeux cités dans le journal.">
      <p class="mt-2 text-sm text-base-content/85">{games.length} jeux</p>
    </PageHeader>
    <LetterNav letters={letters} />
    {
      letters.map((letter) => (
        <section class="mb-10" aria-labelledby={anchor(letter)}>
          <LetterHeading letter={letter} />
          <ul class="grid grid-cols-2 gap-3 pt-3 sm:gap-6 md:grid-cols-3 lg:grid-cols-4">
            {groups.get(letter)!.map((game) => (
              <li>
                <GameTile game={game} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
