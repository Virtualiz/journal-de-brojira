---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import BackLink from "../../../components/BackLink.astro";
import PageHeader from "../../../components/PageHeader.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const uniqueTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return uniqueTags.flatMap((tag) =>
    paginate(
      posts.filter((post) => post.data.tags.includes(tag)),
      { params: { tag }, pageSize: 6 },
    ),
  );
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { page } = Astro.props;
---

<BaseLayout
  pageTitle={`${tag.replace(/^./, tag[0].toUpperCase())}${page.currentPage > 1 ? ` – page ${page.currentPage}` : ""}`}
  description={`Les articles du journal de Brojira avec le tag « ${tag} » (${page.total}).`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-8 lg:py-12">
    <BackLink href="/tags/" label="Tous les tags" />
    <PageHeader title={`# ${tag}`}>
      <p class="mt-2 text-sm text-base-content/85">{page.total} {page.total > 1 ? "billets" : "billet"}</p>
    </PageHeader>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        page.data.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>

    <Pagination page={page} base={`/tags/${tag}/`} />
  </div>
</BaseLayout>
