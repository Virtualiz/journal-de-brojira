---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import GameSections from "../../components/GameSections.astro";
import Icon from "../../components/Icon.astro";
import PageHeader from "../../components/PageHeader.astro";

export const getStaticPaths = (async () => {
  const people = await getCollection("people");
  const games = await getCollection("games");
  return people.map((person) => ({
    params: { id: person.id },
    props: {
      person,
      authored: games.filter((g) => g.data.authors.some((a) => a.id === person.id)),
      illustrated: games.filter((g) => g.data.artists.some((a) => a.id === person.id)),
    },
  }));
}) satisfies GetStaticPaths;

const { person, authored, illustrated } = Astro.props;
const sections = [
  { id: "auteur", title: "Jeux conçus", games: authored },
  { id: "illustrateur", title: "Jeux illustrés", games: illustrated },
];
---

<BaseLayout pageTitle={person.data.name} description={person.data.bio ?? `${person.data.name} : jeux conçus et illustrés.`}>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-8 lg:py-12">
    <BackLink href="/auteurs/" label="Tous les auteurs" />
    <PageHeader title={person.data.name} subtitle={person.data.bio}>
      {
        person.data.url && (
          <p class="mt-3">
            <a class="inline-flex items-center gap-1.5 link link-primary" href={person.data.url} rel="noopener">
              <Icon name="link" class="size-4" />
              Site web
            </a>
          </p>
        )
      }
    </PageHeader>
    <GameSections sections={sections} />
  </div>
</BaseLayout>
