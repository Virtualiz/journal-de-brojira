---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import LetterNav from "../../components/LetterNav.astro";
import LetterHeading from "../../components/LetterHeading.astro";
import { anchor, groupByLetter } from "../../lib/alphabet";

const people = await getCollection("people");
const { letters, groups } = groupByLetter(people, (p) => p.data.name);
---

<BaseLayout
  pageTitle="Auteurs et illustrateurs"
  description="Les auteurs et illustrateurs des jeux cités dans le journal."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-8 lg:py-12">
    <PageHeader title="Auteurs & illustrateurs" subtitle="Les auteurs, autrices, illustratrices et illustrateurs des jeux cités dans le journal.">
      <p class="mt-2 text-sm text-base-content/85">{people.length} personnes</p>
    </PageHeader>
    <LetterNav letters={letters} />
    {
      letters.map((letter) => (
        <section class="mb-6" aria-labelledby={anchor(letter)}>
          <LetterHeading letter={letter} />
          <ul class="flex flex-wrap gap-3">
            {groups.get(letter)!.map((p) => (
              <li>
                <a
                  class="btn btn-outline btn-primary rounded-full normal-case"
                  href={`/auteurs/${p.id}/`}
                >
                  {p.data.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
