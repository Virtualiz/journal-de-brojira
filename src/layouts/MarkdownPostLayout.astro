---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
const date = frontmatter.pubDate.toLocaleDateString("fr", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const dateDisplay = date.charAt(0).toUpperCase() + date.slice(1);
---

<BaseLayout pageTitle={frontmatter.title}>
  <div class="pt-2 pl-2 pr-2">
    <p class="text-sm">
      {frontmatter.author}, {dateDisplay}
    </p>
    <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />
    <h1 class="text-xl mt-2">{frontmatter.title}</h1>
    <p class="text-sm"><em>{frontmatter.description}</em></p>
    <br>
    <slot />

    <div class="mt-2">
      {
        frontmatter.tags.map((tag: string) => (
          <p class="badge badge-soft badge-primary mr-2">
            <a href={`/tags/${tag}`}>{tag}</a>
          </p>
        ))
      }
    </div>

  </div>
</BaseLayout>
